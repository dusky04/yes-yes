# --- Video data is NOT committed to git ---------------------------------
# GitHub rejects files > 100 MB and a video dataset will bloat the repo.
# The clips live in Drive; the repo ships the structure, scripts, and metadata.
# If you WANT the videos versioned, use Git LFS instead of ignoring them
# (see README "Hosting the videos"). To keep empty class folders in git,
# a .gitkeep is committed in each; the clips themselves are ignored.
videos/**/*.mp4
videos/**/*.mov
videos/**/*.avi
videos/**/*.mkv
videos/**/*.m4v
raw_clips/
frames/

# Pipeline intermediates (regenerated by the scripts)
annotations/_metadata_cache.csv
annotations/_split_assignments.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Virtual environments
.venv

